# Copy this file to .env. Never commit .env or replace these placeholders in it.
# Generate secrets with: openssl rand -hex 32
POSTGRES_DB=pfos
POSTGRES_USER=pfos
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://pfos:replace-with-a-long-random-password@db:5432/pfos
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRE_MINUTES=1440
# Keep this value in your encrypted password manager and disaster-recovery backup.
CONNECTION_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENVIRONMENT=sandbox
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
